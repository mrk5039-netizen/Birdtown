# --- Anthropic (required) ---
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- Rep identity (used in email signature / sender line) ---
SDR_REP_NAME=Alex Rivera
SDR_REP_TITLE=Account Executive
SDR_REP_EMAIL=alex@concentric.com
SDR_CALENDAR_LINK=https://calendly.com/concentric/intro

# --- Safety ---
# true  = agent only DRAFTS emails / PROPOSES meetings (human approves). Default.
# false = LIVE. Only set false with explicit authorization.
SDR_DRY_RUN=true

# --- Optional logging ---
# Slack channel id to post qualified-lead summaries to.
SDR_SLACK_CHANNEL=

# --- Live integrations (optional) ---
# Path to a JSON file listing remote MCP servers to connect (see
# mcp_servers.example.json). When unset, the agent uses local stub tools only.
SDR_MCP_CONFIG=

# Bearer tokens referenced by mcp_servers.example.json (only the ones you use):
ZOOMINFO_MCP_TOKEN=
GMAIL_MCP_TOKEN=
GCAL_MCP_TOKEN=
SLACK_MCP_TOKEN=
